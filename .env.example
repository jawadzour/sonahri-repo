# === Server ===
NODE_ENV=development
PORT=3000

# Secret used to sign the admin login JWT cookie. Use any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# === Database (Postgres) ===
# Local dev: `docker compose up -d db` starts a Postgres container matching
# the values below. In production (Render), DATABASE_URL is provided
# automatically by the linked managed database.
DATABASE_URL=postgresql://shds:shdspass@127.0.0.1:5432/shds

# === Admin login ===
# Email you'll use to log into /admin/login
ADMIN_EMAIL=admin@example.com
# Generate this hash by running: node scripts/generate-password-hash.mjs "yourpassword"
ADMIN_PASSWORD_HASH=

# === Email (contact form notifications) ===
# Example using Gmail SMTP: create an "App Password" in your Google account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-16-char-app-password
# Where contact form submissions get emailed to (defaults to SMTP_USER if blank)
CONTACT_NOTIFY_EMAIL=
