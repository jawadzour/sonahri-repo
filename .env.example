# === Server ===
NODE_ENV=development
PORT=3000

# Secret used to sign the admin login JWT cookie. Use any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# === Database (MySQL via XAMPP/Laragon) ===
# XAMPP default: host=localhost, port=3306, user=root, password=(empty)
# 1. Start MySQL from XAMPP control panel
# 2. Open phpMyAdmin (http://localhost/phpmyadmin) and create a database, e.g. "shds_website"
# 3. Fill in the connection string below:
DATABASE_URL=mysql://root:@localhost:3306/shds_website

# === Admin login ===
# Email you'll use to log into /admin/login
ADMIN_EMAIL=admin@example.com
# Generate this hash by running: node scripts/generate-password-hash.mjs "yourpassword"
ADMIN_PASSWORD_HASH=

# === Email (contact form notifications) ===
# Example using Gmail SMTP: create an "App Password" in your Google account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-16-char-app-password
# Where contact form submissions get emailed to (defaults to SMTP_USER if blank)
CONTACT_NOTIFY_EMAIL=
