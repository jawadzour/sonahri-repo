# Flask application
APP_CONFIG=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# PostgreSQL (the backend docker-compose service uses these defaults)
DATABASE_URL=postgresql+psycopg://shds_user:shds_password@localhost:5432/shds_db

# Local frontends and uploads
CORS_ORIGINS=http://localhost:3000,http://localhost:5174
BACKEND_BASE_URL=http://localhost:5000
ADMIN_FRONTEND_URL=http://localhost:5174
UPLOAD_FOLDER=uploads

# Optional email notifications, sent via Brevo's HTTP API (not SMTP -
# see app/utils/mailer.py for why). Sign up free at brevo.com, verify a
# sender address under Senders & IP > Senders (no domain/DNS needed),
# then generate an API key under SMTP & API > API Keys.
MAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SHDS
